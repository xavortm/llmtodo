#!/usr/bin/env python3
"""Tests ways to estimate a ticket's time and cost against measured tickets.

It reads docs/estimates/tickets.json, which scripts/estimate-report writes,
and uses only tickets measured in full.

    scripts/estimate-fit             print the test results
    scripts/estimate-fit --snapshot  first read each ticket's description as
                                     it was when the agent estimated it, and
                                     write docs/estimates/at-estimate.json

Methods:

- agent:        the agent's own frozen estimate.
- agent-scaled: the agent's estimate times one scale fitted on the training
                tickets. This is the "multiply by 0.4" rule of the guide.
- median:       the median of the training tickets, the same for every ticket.
- code:         a ridge fit on log minutes over fields code can count.
- code+agent:   the code fields plus the log of the agent's estimate.

Each method is tested two ways. Leave-one-out fits on every ticket but one
and predicts that one. The time split fits on the older 70% and predicts the
newest 30%, as a real estimate would.

Every fit reads the description as it was at the estimate, not the final
one. Agents add Agent notes during the work, so the final description is
about 5 times longer, and its length predicts the real time far too well.
"""
import argparse, concurrent.futures, importlib.machinery, json, math, pathlib, re, statistics, subprocess, sys

root = pathlib.Path(__file__).resolve().parent.parent
DATA = root / "docs" / "estimates" / "tickets.json"
SNAPSHOT = root / "docs" / "estimates" / "at-estimate.json"
PUBLIC_TEXT_PROJECTS = {"llmtodo"}
RIDGE = 3.0  # Fixed before testing; the same for every fit.

# ---------------------------------------------------------------------------
# The description as it was when the agent estimated the ticket.

sys.dont_write_bytecode = True
report_mod = importlib.machinery.SourceFileLoader("estimate_report", str(root / "scripts" / "estimate-report")).load_module()


def snapshot_one(t):
    out = subprocess.check_output(["llmtodo", "issue", "history", t["key"], "--bodies", "--no-input"], cwd=root)
    revs = sorted(json.loads(out)["revisions"], key=lambda r: int(r["version"]))
    at = t["estimated_at"] or revs[0]["created_at"]
    before = [r for r in revs if r["created_at"] <= at] or revs[:1]
    desc = before[-1]["body"] or ""
    lower = (t["title"] + "\n" + desc).lower() if t.get("title") else desc.lower()
    row = {
        "version": int(before[-1]["version"]),
        "words": len(desc.split()),
        "crates": sorted(c for c in report_mod.CRATES if re.search(rf"crates/{re.escape(c)}\b", lower)),
        "gpui": "crates/ui" in lower or "gpui" in lower,
        "server_and_app": bool(report_mod.CROSS_WORDS.search(desc)) and bool(re.search(r"\bcli\b", desc, re.I)),
    }
    if t["project"] in PUBLIC_TEXT_PROJECTS:
        row["description"] = desc
    return t["key"], row


def write_snapshot(tickets):
    with concurrent.futures.ThreadPoolExecutor(8) as ex:
        rows = dict(ex.map(snapshot_one, tickets))
    SNAPSHOT.write_text(json.dumps(dict(sorted(rows.items())), indent=1) + "\n")


SNAP = {}


# ---------------------------------------------------------------------------
# Features code can count, from the description at the estimate.

def code_features(t):
    s = SNAP[t["key"]]
    # Tickets without text in the data set keep the flag from the final text.
    if t.get("title"):
        ui = "Area/app" in t["labels"] or t["title"].lower().startswith("app:") or s["gpui"]
    else:
        ui = t["ui"]
    return [
        float(ui),
        float(t["bug"]),
        float(t["visual"]),
        float(s["server_and_app"]),
        float(t["kind"] in ("research or review", "project setup", "refactor")),
        float(len(s["crates"])),
        math.log(1 + s["words"]),
        float(t["project"] == "llmtodo"),
        float(t["parent"] is not None),
    ]


def agent_feature(t, target):
    return [math.log(t["estimate_minutes"] if target == "min" else t["estimate_cost_usd"])]


# ---------------------------------------------------------------------------
# A small ridge fit, with no numpy.

def solve(A, b):
    n = len(A)
    M = [row[:] + [b[i]] for i, row in enumerate(A)]
    for c in range(n):
        p = max(range(c, n), key=lambda r: abs(M[r][c]))
        M[c], M[p] = M[p], M[c]
        for r in range(n):
            if r != c and M[c][c]:
                f = M[r][c] / M[c][c]
                M[r] = [x - f * y for x, y in zip(M[r], M[c])]
    return [M[i][n] / M[i][i] for i in range(n)]


def ridge_fit(X, y, lam=RIDGE):
    k = len(X[0])
    mu = [statistics.mean(r[j] for r in X) for j in range(k)]
    sd = [statistics.pstdev([r[j] for r in X]) or 1.0 for j in range(k)]
    Z = [[(r[j] - mu[j]) / sd[j] for j in range(k)] for r in X]
    ym = statistics.mean(y)
    A = [[sum(z[i] * z[j] for z in Z) + (lam if i == j else 0) for j in range(k)] for i in range(k)]
    b = [sum(z[i] * (yy - ym) for z, yy in zip(Z, y)) for i in range(k)]
    w = solve(A, b)
    return lambda r: ym + sum(wj * (r[j] - mu[j]) / sd[j] for j, wj in enumerate(w))


# ---------------------------------------------------------------------------
# Methods. Each takes training tickets and returns a function that predicts
# the log of minutes or cost for one ticket.

def actual(t, target):
    return math.log(t["active_minutes"] if target == "min" else t["cost_usd"])


def m_agent(train, target):
    return lambda t: agent_feature(t, target)[0]


def m_agent_scaled(train, target):
    s = statistics.median(actual(t, target) - agent_feature(t, target)[0] for t in train)
    return lambda t: agent_feature(t, target)[0] + s


def m_median(train, target):
    m = statistics.median(actual(t, target) for t in train)
    return lambda t: m


def m_fit(feats):
    def method(train, target):
        f = lambda t: feats(t, target)
        p = ridge_fit([f(t) for t in train], [actual(t, target) for t in train])
        return lambda t: p(f(t))
    return method


def score(pairs):
    err = [abs(p - a) for p, a in pairs]
    within2 = sum(e <= math.log(2) for e in err) / len(err)
    bias = statistics.median(p - a for p, a in pairs)
    return {
        "n": len(pairs),
        "factor": math.exp(statistics.mean(err)),
        "within2": within2,
        "bias": math.exp(bias),
        "rank": spearman([p for p, _ in pairs], [a for _, a in pairs]),
    }


def ranks(v):
    order = sorted(range(len(v)), key=lambda i: v[i])
    r = [0.0] * len(v)
    for pos, i in enumerate(order):
        r[i] = pos
    return r


def spearman(a, b):
    ra, rb = ranks(a), ranks(b)
    ma, mb = statistics.mean(ra), statistics.mean(rb)
    num = sum((x - ma) * (y - mb) for x, y in zip(ra, rb))
    den = math.sqrt(sum((x - ma) ** 2 for x in ra) * sum((y - mb) ** 2 for y in rb))
    return num / den if den else 0.0


def leave_one_out(method, tickets, target):
    return [(method([u for u in tickets if u is not t], target)(t), actual(t, target)) for t in tickets]


def time_split(method, tickets, target, share=0.7):
    s = sorted(tickets, key=lambda t: t["completed_at"])
    cut = round(len(s) * share)
    p = method(s[:cut], target)
    return [(p(t), actual(t, target)) for t in s[cut:]]


def fmt_rank(name, test, r):
    # A constant has no rank. Leave-one-out moves each fit a little against
    # the held-out ticket, which lowers its rank, so only the time split shows it.
    return "-" if name == "median" or test == "LOO" else f"{r:.2f}"


def report(title, methods, tickets):
    print(f"\n## {title} ({len(tickets)} tickets)\n")
    print("factor: typical error as a factor, 1.0 is perfect. within2: share inside 2x.")
    print("bias: median predicted / actual. rank: Spearman correlation, time split only.\n")
    print(f"| method | target | test | n | factor | within2 | bias | rank |")
    print("|---|---|---|---|---|---|---|---|")
    for target in ("min", "cost"):
        for name, m in methods.items():
            for test, fn in (("LOO", leave_one_out), ("time", time_split)):
                r = score(fn(m, tickets, target))
                print(f"| {name} | {target} | {test} | {r['n']} | {r['factor']:.2f} | {r['within2']:.0%} | {r['bias']:.2f} | {fmt_rank(name, test, r['rank'])} |")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--snapshot", action="store_true", help="read each description as it was at the estimate")
    args = ap.parse_args()

    rows = json.loads(DATA.read_text())["tickets"]
    full = [t for t in rows if not t["interleaved"] and t["unmeasured_sessions"] == 0
            and (t["active_minutes"] or 0) >= 1 and t["estimate_minutes"] and t["estimate_cost_usd"]
            and t["cost_usd"]]
    text = [t for t in full if t["project"] in PUBLIC_TEXT_PROJECTS and t.get("title")]
    if args.snapshot or not SNAPSHOT.exists():
        write_snapshot(full)
    SNAP.update(json.loads(SNAPSHOT.read_text()))

    base = {
        "agent": m_agent,
        "agent-scaled": m_agent_scaled,
        "median": m_median,
        "code": m_fit(lambda t, g: code_features(t)),
        "code+agent": m_fit(lambda t, g: code_features(t) + agent_feature(t, g)),
    }
    report("Every project", base, full)
    report("llmtodo tickets", base, text)


if __name__ == "__main__":
    main()
