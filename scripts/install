#!/bin/sh
# Installs the llmtodo binary, restarts the owner's server on it, and
# regenerates the agent CLI reference.
set -eu
cd "$(dirname "$0")/.."
cargo install --quiet --locked --path crates/cli
llmtodo server stop >/dev/null 2>&1 || true
scripts/gen-agent-docs "$HOME/.cargo/bin/llmtodo"
llmtodo server status --fields running,health.version
