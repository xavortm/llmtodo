#!/usr/bin/env bash
# Ask agy to review a ticket's branch. The ticket must wait on the reviewer
# (move it to In Review first). agy answers with `llmtodo issue review answer`;
# this script then prints that answer for the builder to apply.
#
#   scripts/request-review LLM-589          # reviews main...HEAD
#   scripts/request-review LLM-589 abc1234  # reviews abc1234...HEAD
#
# AGY_MODEL picks the agy model (`agy models` lists them), default
# gemini-4-neon-high. Ported from llmvid's scripts/request-review.
# Exit: 0 pass, 3 changes requested, 1 no answer written, 2 bad input.
set -euo pipefail

if [[ $# -lt 1 || -z "${1:-}" ]]; then
  echo "usage: scripts/request-review <KEY> [base-ref]" >&2
  exit 2
fi
key=$1
root=$(git rev-parse --show-toplevel)
cd "$root"

base=$(git rev-parse --verify --quiet "${2:-main}^{commit}") || { echo "unknown base ref: ${2:-main}" >&2; exit 2; }
head=$(git rev-parse HEAD)
if [[ -n "$(git status --porcelain)" ]]; then
  echo "commit your changes first: the reviewer reads commits, not the working tree" >&2
  exit 2
fi

reviews() { llmtodo issue review show "$key" --no-input; }
# Fails the script on an unknown key or a tracker error.
state=$(reviews | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("waiting_on") or "none", len(d["answers"]), d["status"])')
read -r waiting before status <<<"$state"
if [[ $waiting != reviewer ]]; then
  echo "$key is in $status and waits on $waiting, not the reviewer." >&2
  echo "Move it first: llmtodo issue update $key --status \"In Review\"" >&2
  exit 2
fi
round=$((before + 1))

# agy reviews a throwaway clone, never this checkout. Its permission rules do
# not hold it to read-only commands (in llmvid a `git log` rule let
# `git branch` through, and it turned its own sandbox off), so isolation is
# the guard.
work=$(mktemp -d "${TMPDIR:-/tmp}/llmtodo-review.XXXXXX")
trap 'rm -rf "$work"' EXIT
trap 'exit 130' INT   # bash 3.2 skips the EXIT trap on signals without these
trap 'exit 143' TERM
clone="$work/llmtodo"
# No hardlinks and no remote: nothing done in the clone reaches this repo.
git clone -q --local --no-hardlinks --no-checkout "$root" "$clone"
git -C "$clone" remote remove origin
git -C "$clone" checkout -q --detach "$head"
# The build cache, as an APFS copy that takes seconds and almost no disk.
[[ -d target ]] && { cp -cRp target "$clone/target" 2>/dev/null || cp -Rp target "$clone/target"; }

short_base=$(git rev-parse --short "$base")
short_head=$(git rev-parse --short "$head")
prompt="Review llmtodo ticket $key as the reviewer, following the llmtodo-review skill in .claude/skills/llmtodo-review/SKILL.md. Base: $short_base. Head: $short_head. This is round $round. Do not edit any file. Answer with llmtodo issue review answer, once."

settings='{"permissions":{"allow":["command(llmtodo)","command(git)","command(cargo)","command(ls)","command(cat)","command(grep)","command(rg)","command(find)","command(head)","command(tail)","command(wc)","command(sed)"]}}'

model=${AGY_MODEL:-gemini-4-neon-high}
effort=${model##*-}
case $effort in low|medium|high|xhigh|max) family=${model%-*} ;; *) family=$model effort= ;; esac

# A clean environment with only what the tools need. Nothing from Claude Code
# reaches agy. llmtodo does not detect agy (it sets ANTIGRAVITY_*, not
# AI_AGENT), so without LLMTODO_ACTOR it would act as the owner, who may
# approve. The actor makes it the reviewer agent.
keep=(HOME PATH USER LOGNAME SHELL TERM LANG LC_ALL TMPDIR
      CARGO_HOME RUSTUP_HOME XDG_CONFIG_HOME XDG_DATA_HOME XDG_CACHE_HOME XDG_STATE_HOME
      LLMTODO_DATA_DIR LLMTODO_CONFIG_DIR)
envs=()
for v in "${keep[@]}"; do [[ -n "${!v:-}" ]] && envs+=("$v=${!v}"); done

echo "agy ($model) is reviewing $key (round $round, $short_base...$short_head) in ${clone}…" >&2
(
  cd "$clone"
  env -i "${envs[@]}" \
    LLMTODO_ACTOR="agent:antigravity/$family/$effort" \
    LLMTODO_SESSION="agy-review-$key-$round-$short_head" \
    agy -p "$prompt" --model "$model" --settings "$settings" --print-timeout 1800s >&2
) || echo "agy exited with $?; checking for an answer anyway" >&2

answer=$(reviews | python3 -c '
import json, sys
d = json.load(sys.stdin)
new = d["answers"][int(sys.argv[1]):]
if new:
    a = new[-1]
    print(a["verdict"])
    print("Round %s: %s by %s" % (a["round"], a["verdict"], a["author"]["name"]))
    print()
    print(a.get("feedback") or "(no feedback)")
' "$before")
if [[ -z "$answer" ]]; then
  echo "agy finished but wrote no review answer on $key" >&2
  exit 1
fi
verdict=$(head -n1 <<<"$answer")
tail -n +2 <<<"$answer"
[[ $verdict == passed ]] && exit 0
exit 3
