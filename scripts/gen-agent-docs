#!/usr/bin/env python3
"""Writes docs/agents/cli-reference.md from `llmtodo schema`."""
import json, subprocess, sys, pathlib

root = pathlib.Path(__file__).resolve().parent.parent
# This checkout's debug build, so the docs match the code here and not an
# installed binary from another branch.
local = root / "target" / "debug" / "llmtodo"
if len(sys.argv) > 1:
    binary = sys.argv[1]
else:
    subprocess.check_call(["cargo", "build", "-q", "-p", "llmtodo-cli"], cwd=root)
    binary = str(local)
schema = json.loads(subprocess.check_output([binary, "schema"], cwd=root))

lines = [
    "# llmtodo CLI reference",
    "",
    f"Generated by `scripts/gen-agent-docs` from `llmtodo schema`, version {schema['version']}. Do not edit by hand.",
    "",
    "## Global flags",
    "",
]
for f in schema["global_flags"]:
    flag = ", ".join(x for x in [f.get("short"), f.get("long")] if x)
    lines.append(f"- `{flag}`: {f.get('help') or ''}".rstrip())
lines += ["", "## Exit codes", "", "| Code | Meaning |", "|---|---|"]
for code, meaning in sorted(schema["exit_codes"].items(), key=lambda kv: int(kv[0])):
    lines.append(f"| {code} | {meaning} |")
if schema.get("error_codes"):
    lines += ["", "## Error codes", "", "Errors print `{\"error\": {\"code\": \"...\", \"message\": \"...\"}}` on stderr when the output is JSON.", "", "| Code | Exit code |", "|---|---|"]
    for name, exit_code in sorted(schema["error_codes"].items(), key=lambda kv: (kv[1], kv[0])):
        lines.append(f"| `{name}` | {exit_code} |")
lines += ["", "## Commands", ""]
for c in schema["commands"]:
    lines.append(f"### `llmtodo {c['command']}`")
    lines.append("")
    if c.get("about"):
        lines += [c["about"], ""]
    for a in c["args"]:
        if a["positional"]:
            name = f"<{a['name']}>"
        else:
            name = ", ".join(x for x in [a.get("short"), a.get("long")] if x)
            if a["takes_value"]:
                name += f" <{a['name']}>"
        extra = []
        if a["required"] and not a["positional"]:
            extra.append("required")
        if a["repeatable"]:
            extra.append("repeatable")
        if a.get("values"):
            extra.append("one of: " + ", ".join(a["values"]))
        help_text = (a.get("help") or "").replace("\n", " ")
        suffix = f" ({'; '.join(extra)})" if extra else ""
        lines.append(f"- `{name}`{suffix}: {help_text}".rstrip(": "))
    lines.append("")
lines += ["## API routes", "", "| Method | Path | CLI | Summary |", "|---|---|---|---|"]
for r in schema["api"]["routes"]:
    lines.append(f"| {r['method']} | `{r['path']}` | `{r['cli']}` | {r['summary']} |")
lines.append("")
lines.append("Request and response schemas: `llmtodo schema | jq '.api'`.")
(root / "docs/agents/cli-reference.md").write_text("\n".join(lines) + "\n")
print("wrote docs/agents/cli-reference.md")
